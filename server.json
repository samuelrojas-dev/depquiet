{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.samuelrojas-dev/depquiet",
  "title": "depquiet",
  "description": "Plans the change that closes your dependency alerts, verified with uv or Poetry.",
  "repository": {
    "url": "https://github.com/samuelrojas-dev/depquiet",
    "source": "github"
  },
  "version": "0.58.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "depquiet",
      "version": "0.58.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "mcp>=2.3,<3"
        },
        {
          "type": "named",
          "name": "--with",
          "value": "pip-audit"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
